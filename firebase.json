{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "versao1/**",
      "versao2/**",
      "versao3/**",
      "teste/**",
      "README.md",
      "firestore.rules",
      "index.html",
      "dados_antigos/**",
      "**/*or*amento*.png"
    ],
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/sistema",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/sistema/",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/app.html",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
